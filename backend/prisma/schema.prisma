generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MERCHANT_OWNER
  MERCHANT_MANAGER
  CONSUMER
}

enum CompanyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  CLOSED_TEMPORARY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum OfferStatus {
  ACTIVE
  EXPIRED
  SCHEDULED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PriceType {
  REGULAR
  PROMOTIONAL
}

enum ContactType {
  PHONE
  WHATSAPP
  EMAIL
}

enum EventType {
  SEARCH
  PRODUCT_VIEW
  STORE_VIEW
  MAP_OPEN
  FILTER_USED
  PRODUCT_FAVORITE
  STORE_FAVORITE
  WHATSAPP_CLICK
  PHONE_CLICK
  ROUTE_REQUESTED
  AVAILABILITY_CHECK
  REVIEW_CREATED
  REVIEW_APPROVED
  REVIEW_REJECTED
  PRODUCT_SHARED
  ALERT_CREATED
}

enum FavoriteTargetType {
  PRODUCT
  STORE
}

enum ReviewTargetType {
  PRODUCT
  STORE
}

enum AlertTriggerType {
  PRICE_BELOW
  PRICE_ABOVE
  BACK_IN_STOCK
  NEW_OFFER
}

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportType {
  CSV
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  phone        String?
  role         UserRole @default(CONSUMER)
  active       Boolean  @default(true)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  companies UserCompany[]
  favorites Favorite[]
  reviews   Review[]
  alerts    Alert[]
  events    Event[]

  @@map("users")
}

model UserCompany {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  role      UserRole @default(MERCHANT_MANAGER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@map("user_companies")
}

model Company {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  cnpj        String?       @unique
  description String?
  logoUrl     String?       @map("logo_url")
  status      CompanyStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  users       UserCompany[]
  stores      Store[]
  products    Product[]
  offers      Offer[]
  brands      Brand[]
  importJobs  ImportJob[]
  companyPlan CompanyPlan?

  @@map("companies")
}

model Store {
  id           String                                @id @default(uuid()) @db.Uuid
  companyId    String                                @map("company_id") @db.Uuid
  name         String
  slug         String
  description  String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  addressNum   String?                               @map("address_num")
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?                               @map("zip_code")
  country      String                                @default("BR")
  location     Unsupported("geography(Point, 4326)")
  status       StoreStatus                           @default(ACTIVE)
  createdAt    DateTime                              @default(now()) @map("created_at")
  updatedAt    DateTime                              @updatedAt @map("updated_at")
  deletedAt    DateTime?                             @map("deleted_at")
  ratingAverage Decimal?     @map("rating_average") @db.Decimal(3, 2)
  ratingCount   Int          @default(0) @map("rating_count")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices     Price[]
  inventory  Inventory[]
  contacts   Contact[]
  offers     Offer[]
  importJobs ImportJob[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("stores")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  brandId     String?       @map("brand_id") @db.Uuid
  name        String
  slug        String
  description String?
  sku         String?
  barcode     String?
  imageUrl    String?       @map("image_url")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  ratingAverage Decimal?     @map("rating_average") @db.Decimal(3, 2)
  ratingCount   Int          @default(0) @map("rating_count")

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories ProductCategory[]
  prices     Price[]
  inventory  Inventory[]
  offers     OfferProduct[]
  tags       ProductTag[]

  @@unique([companyId, slug])
  @@unique([companyId, sku])
  @@index([companyId])
  @@index([brandId])
  @@map("products")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  group     String?
  createdAt DateTime @default(now()) @map("created_at")

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String   @map("product_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  slug      String
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("brands")
}

model Price {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  type      PriceType @default(REGULAR)
  value     Decimal   @db.Decimal(10, 2)
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
  @@index([storeId, productId])
  @@map("prices")
}

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([productId])
  @@map("inventory")
}

model Offer {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  storeId       String?      @map("store_id") @db.Uuid
  title         String
  description   String?
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  status        OfferStatus  @default(ACTIVE)
  startsAt      DateTime?    @map("starts_at")
  endsAt        DateTime?    @map("ends_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store    Store?         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products OfferProduct[]

  @@index([companyId])
  @@index([storeId])
  @@index([status])
  @@map("offers")
}

model OfferProduct {
  id        String   @id @default(uuid()) @db.Uuid
  offerId   String   @map("offer_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
  @@index([productId])
  @@map("offer_products")
}

model Favorite {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  targetType FavoriteTargetType @map("target_type")
  targetId   String             @map("target_id") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
  @@map("favorites")
}

model Review {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  targetType ReviewTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  rating     Int
  title      String?
  comment    String?
  status     ReviewStatus     @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  moderatedById String?       @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?     @map("moderated_at")
  moderationNote String?      @map("moderation_note")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("reviews")
}

model Contact {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  storeId   String      @map("store_id") @db.Uuid
  type      ContactType
  value     String
  metadata  Json?
  createdAt DateTime    @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
  @@map("contacts")
}

model Alert {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  targetType        String           @map("target_type")
  targetId          String           @map("target_id") @db.Uuid
  trigger           AlertTriggerType
  threshold         Decimal?         @db.Decimal(10, 2)
  active            Boolean          @default(true)
  lastTriggeredAt   DateTime?        @map("last_triggered_at")
  triggeredCount    Int              @default(0) @map("triggered_count")
  lastObservedValue Decimal?         @map("last_observed_value") @db.Decimal(10, 2)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
  @@index([targetType, targetId])
  @@map("alerts")
}

model Event {
  id         String    @id @default(uuid()) @db.Uuid
  type       EventType
  userId     String?   @map("user_id") @db.Uuid
  sessionId  String?   @map("session_id")
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  metadata   Json?
  lat        Decimal?  @db.Decimal(10, 8)
  lng        Decimal?  @db.Decimal(11, 8)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([type, targetId, createdAt])
  @@index([userId])
  @@index([sessionId])
  @@index([targetType, targetId])
  @@map("events")
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  storeId     String?      @map("store_id") @db.Uuid
  store       Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  type        ImportType   @default(CSV)
  status      ImportStatus @default(PENDING)
  fileName    String       @map("file_name")
  fileKey     String       @map("file_key")
  total       Int          @default(0)
  processed   Int          @default(0)
  success     Int          @default(0)
  errors      Int          @default(0)
  errorDetail Json?        @map("error_detail")
  createdAt   DateTime     @default(now()) @map("created_at")
  startedAt   DateTime?    @map("started_at")
  finishedAt  DateTime?    @map("finished_at")

  importErrors ImportError[]

  @@index([companyId])
  @@index([status])
  @@map("import_jobs")
}

model ImportError {
  id          String    @id @default(uuid()) @db.Uuid
  importJobId String    @map("import_job_id") @db.Uuid
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  line        Int
  field       String?
  code        String
  message     String
  value       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([importJobId])
  @@map("import_errors")
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  tier        PlanTier @unique
  description String?
  maxStores   Int      @default(1) @map("max_stores")
  maxProducts Int      @default(100) @map("max_products")
  maxImports  Int      @default(3) @map("max_imports")
  maxMembers  Int      @default(2) @map("max_members")
  analytics   Boolean  @default(false)
  alerts      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  companies CompanyPlan[]

  @@map("plans")
}

model CompanyPlan {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @unique @map("company_id") @db.Uuid
  planId    String    @map("plan_id") @db.Uuid
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("company_plans")
}
