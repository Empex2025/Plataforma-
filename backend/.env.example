# ============================================================
# EncontraÊ backend — environment variables
# Copy to `.env` and adjust. Values below are development defaults.
# ============================================================

# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/local_commerce"
# Minimum 16 characters. Used to sign/verify JWT access tokens.
JWT_SECRET="change-me-in-production-min-16-chars"

# --- Optional (defaults shown) ---
NODE_ENV=development
PORT=3000

# --- Auth / JWT ---
# Access token (curta duração) + refresh token rotativo (armazenado no Valkey).
JWT_ACCESS_EXPIRATION="15m"
# Se definido, assina os refresh tokens com um segredo separado (mínimo 16 chars).
# JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION="7d"
# Duração do refresh token em ms (default 7 dias). Deve acompanhar JWT_REFRESH_EXPIRATION.
# JWT_REFRESH_TTL_MS=604800000
# Bloqueio de conta após N tentativas de login falhas (default 5) por X ms (default 15 min).
# AUTH_MAX_LOGIN_ATTEMPTS=5
# AUTH_LOCKOUT_TTL_MS=900000
# Validade do código OTP de recuperação de senha em ms (default 10 min).
# PASSWORD_RESET_OTP_TTL_MS=600000
# Validade do código OTP de verificação de e-mail/telefone em ms (default 10 min).
# VERIFICATION_OTP_TTL_MS=600000

# --- Mailer (opcional) ---
# Sem MAILER_API_URL o envio é apenas logado (console). Com MAILER_API_URL, os e-mails
# são enviados via POST JSON { from, to, subject, text } para o provedor configurado.
# MAILER_API_URL=https://api.resend.com/emails
# MAILER_API_KEY=
# MAILER_FROM="EncontraÊ <no-reply@encontra.local>"

# --- Valkey / Redis (BullMQ queues + shared rate limit store) ---
VALKEY_HOST=localhost
VALKEY_PORT=6379
# VALKEY_PASSWORD=

# --- Reverse proxy ---
# Number of trusted proxy hops, "true", a comma-separated list, or false (default).
# Set to 1 when the API runs behind a single load balancer/ingress so request.ip
# reflects the real client. Trusting arbitrary proxies exposes IP spoofing.
# TRUST_PROXY=1

# --- Meilisearch (read model for search) ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key-change-in-production

# --- S3 / MinIO (required only for the CSV import feature) ---
# If any S3_* variable is set, S3_ENDPOINT, S3_ACCESS_KEY and S3_SECRET_KEY are all required.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=imports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# URL pública base para servir os arquivos enviados (uploads de logo/capa).
# Default: `${S3_ENDPOINT}/${S3_BUCKET}`. Em MinIO local, torne o bucket público
# de leitura ou aponte para um CDN/proxy.
# S3_PUBLIC_URL=http://localhost:9000/imports

# --- CNPJ lookup (company registration pre-fill) ---
# Provider abstraction: CnpjProvider (interface) -> CnpjWsProvider (initial impl).
# Public CNPJ.ws API: 3 requests/minute per IP. Do NOT add an API key for the public API.
CNPJ_PROVIDER=cnpj-ws
CNPJ_API_BASE_URL=https://publica.cnpj.ws
CNPJ_API_TIMEOUT_MS=5000
# Short in-memory cache (per instance), keyed by normalized CNPJ. Errors are never cached.
CNPJ_CACHE_TTL_MS=300000

# --- AI / Embeddings (optional, Fase 20) ---
# AI is completely optional. When AI_ENABLED is false (default) or the provider
# is unavailable, recommendations fall back to the deterministic engine.
# AI_ENABLED=true
# AI_PROVIDER=local            # local | openai
# EMBEDDING_MODEL=local-deterministic
# EMBEDDING_DIMENSION=64
# EMBEDDING_VECTOR_STORE=array # array | pgvector
# OpenAI-compatible providers (also used for DeepSeek and others):
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=

# --- Experiment statistics (optional, Fase 22) ---
# Defaults shown. Values are validated only when set; invalid values fail startup.
# STATISTICS_MIN_SAMPLE_SIZE=100   # positive integer
# STATISTICS_CONFIDENCE_LEVEL=0.95 # number between 0 and 1 (exclusive)
# STATISTICS_ALPHA=0.05            # number between 0 and 1 (exclusive)

# Disabled automatically when NODE_ENV=test. Counters are stored in Valkey so
# that limits are shared across instances; falls back to memory if Valkey is down.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Comma-separated allowlist. Required in production; permissive when unset in dev.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Production operations (optional, Fase 25) ---
# Pool/timeout tuning. Defaults shown; validated as positive integers when set.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# SEARCH_TIMEOUT_MS=3000
# S3_CONNECT_TIMEOUT_MS=3000
# S3_REQUEST_TIMEOUT_MS=30000
# S3_MAX_ATTEMPTS=3
