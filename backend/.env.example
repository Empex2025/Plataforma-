# ============================================================
# EncontraÊ backend — environment variables
# Copy to `.env` and adjust. Values below are development defaults.
# ============================================================

# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/local_commerce"
# Minimum 16 characters. Used to sign/verify JWT access tokens.
JWT_SECRET="change-me-in-production-min-16-chars"

# --- Optional (defaults shown) ---
NODE_ENV=development
PORT=3000
JWT_EXPIRATION="1d"

# --- Valkey / Redis (BullMQ queues) ---
VALKEY_HOST=localhost
VALKEY_PORT=6379

# --- Meilisearch (read model for search) ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key-change-in-production

# --- S3 / MinIO (required only for the CSV import feature) ---
# If any S3_* variable is set, S3_ENDPOINT, S3_ACCESS_KEY and S3_SECRET_KEY are all required.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=imports
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- AI / Embeddings (optional, Fase 20) ---
# AI is completely optional. When AI_ENABLED is false (default) or the provider
# is unavailable, recommendations fall back to the deterministic engine.
# AI_ENABLED=true
# AI_PROVIDER=local            # local | openai
# EMBEDDING_MODEL=local-deterministic
# EMBEDDING_DIMENSION=64
# EMBEDDING_VECTOR_STORE=array # array | pgvector
# OpenAI-compatible providers (also used for DeepSeek and others):
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=

# --- Experiment statistics (optional, Fase 22) ---
# Defaults shown. Values are validated only when set; invalid values fail startup.
# STATISTICS_MIN_SAMPLE_SIZE=100   # positive integer
# STATISTICS_CONFIDENCE_LEVEL=0.95 # number between 0 and 1 (exclusive)
# STATISTICS_ALPHA=0.05            # number between 0 and 1 (exclusive)

# Disabled automatically when NODE_ENV=test. In-memory store (per instance).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Comma-separated allowlist. Required in production; permissive when unset in dev.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Production operations (optional, Fase 25) ---
# Pool/timeout tuning. Defaults shown; validated as positive integers when set.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# SEARCH_TIMEOUT_MS=3000
# S3_CONNECT_TIMEOUT_MS=3000
# S3_REQUEST_TIMEOUT_MS=30000
# S3_MAX_ATTEMPTS=3
