{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "typescript",
            "decorators": true
          },
          "transform": {
            "legacyDecorator": true,
            "decoratorMetadata": true
          }
        },
        "module": {
          "type": "nodenext"
        }
      }
    ],
    "^.+\\.js$": [
      "@swc/jest",
      {
        "jsc": {
          "transform": {}
        },
        "module": {
          "type": "nodenext"
        }
      }
    ]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs|@prisma|rxjs|bcryptjs|passport|passport-jwt|class-transformer|class-validator|csv-parse|meilisearch)/)"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@/(.*)\\.js$": "<rootDir>/../src/$1",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
